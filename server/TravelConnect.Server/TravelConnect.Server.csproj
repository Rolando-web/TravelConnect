<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TravelConnect.Server.Tests" />
  </ItemGroup>

  <!--
    A running instance locks its own .exe, so rebuilding while one is up fails with
    MSB3021 and the new process then cannot bind :5110 either. Stop the old instance
    before the build so a plain `dotnet run` always works. Debug/Windows only, and the
    helper only ever stops processes running this project's own output binary.
  -->
  <Target Name="StopPreviousServerInstance"
          BeforeTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' AND '$(Configuration)' == 'Debug' AND '$(TargetPath)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\stop-stale-server.ps1&quot; -ExePath &quot;$(TargetPath)&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low" />
  </Target>

</Project>
